{
  "name": "ward-tools",
  "version": "0.0.2",
  "scripts": {
    "start": "concurrently -n app,functions -c green,blue \"npm run start:app\" \"npm run start:functions\"",
    "start:app": "ng serve ward-tools --port 4201",
    "start:functions": "wrangler dev --local",
    "build": "npm run gen-function-route-map && ng build --configuration production",
    "watch": "npm run gen-function-route-map && ng build --watch --configuration development",
    "test": "npm run gen-function-route-map && ng test",
    "gen-types": "supabase gen types typescript --project-id bfozbjjsbwakbucgdpao > database.d.ts",
    "gen-function-route-map": "node scripts/generate-function-route-map.js",
    "gen-icon-codes": "node src/app/shared/icon/gen-icon-codes.ts",
    "update-angular": "npm add @angular/cdk @angular/common @angular/core @angular/forms @angular/platform-browser @angular/router @angular/service-worker @angular/build @angular/cli @angular/compiler @angular/compiler-cli @angular/language-service"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@supabase/supabase-js": "^2.118.0",
    "pdf-lib": "^1.17.1",
    "quill": "^2.0.3",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@cloudflare/workers-types": "^5.20261021.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "concurrently": "^10.0.6",
    "wrangler": "^4.156.0"
  }
}
